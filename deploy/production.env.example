# /opt/beammods/app/.env  (chmod 600, owner beammods)
# ── Telegram ──
BOT_TOKEN=NEW_TOKEN_AFTER_REVOKE
ADMIN_ID=123456789
ARCHIVE_GROUP_ID=-100xxxxxxxxxx
WEB_APP_URL=https://your-miniapp.vercel.app

# ── Webhook mode ──
RUN_MODE=webhook
PUBLIC_BASE_URL=https://api.example.com
# Random path + secret. Generate each with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_PATH=/tg/PASTE_RANDOM_STRING_HERE
WEBHOOK_SECRET=PASTE_ANOTHER_RANDOM_STRING_HERE

# ── HTTP server (only Nginx talks to it) ──
WEB_SERVER_HOST=127.0.0.1
WEBHOOK_PORT=8080
# EXTRA_CORS_ORIGINS=https://other-frontend.example

# ── AI ──
OPENAI_API_KEY=sk-...

# ── Payments ──
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# ── DRM (Phase 2) ──
DRM_SIGNING_KEY_FILE=/opt/beammods/keys/drm_ed25519.pem
DRM_MODS_DIR=/opt/beammods/mod_sources
DRM_TICKET_TTL_DAYS=7

# ── Payments (Phase 3) ──
# Telegram Stars price conversion: UZS per 1 Star (tune to Stars→USD→UZS).
STARS_UZS_RATE=170
# Click/Payme are OPTIONAL & dormant (no UI entry point in the hybrid strategy).
# Leave blank unless you later enable automated gateways.
# Click (merchant cabinet): service_id, merchant_id, SECRET key (used in MD5 sign)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Payme (merchant cabinet): merchant id + KEY (Basic-auth password Payme sends)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# ── Manual card transfer (hybrid local payments) ──
# Shown to UZ users; they upload a receipt and the admin approves in Telegram.
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=Ism Familiya

# ── PostgreSQL (Phase 4) ──
DATABASE_URL=postgresql://beammods:CHANGE_ME@127.0.0.1:5432/beammods
