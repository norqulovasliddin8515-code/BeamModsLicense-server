# ============================================================
# BeamModsStudio — Muhit o'zgaruvchilari namunasi
# Haqiqiy faylni ".env" deb nomlang va hech qachon gitga qo'shmang!
# ============================================================

# Telegram Bot Settings
BOT_TOKEN=your_bot_token_from_BotFather
ADMIN_ID=your_telegram_user_id
ARCHIVE_GROUP_ID=-100xxxxxxxxxx   # Fayl arxiv guruhi ID (manfiy son)

# Mini App (Vercel) manzili — CORS shu origin ga ruxsat beradi
WEB_APP_URL=https://your-miniapp.vercel.app

# OpenAI API
OPENAI_API_KEY=sk-...

# Click.uz Payment Settings
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

# Payme Settings
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# HTTP server (API + to'lov + Telegram webhook)
WEBHOOK_PORT=8080
WEB_SERVER_HOST=0.0.0.0          # VPS da: 127.0.0.1

# Bot rejimi: local dev = polling (ALOHIDA test bot token bilan!), VPS = webhook
RUN_MODE=polling
# Faqat RUN_MODE=webhook uchun:
PUBLIC_BASE_URL=https://api.example.com
WEBHOOK_PATH=/tg/random_string
WEBHOOK_SECRET=another_random_string
